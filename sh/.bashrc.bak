# Shell Options
shopt -s cdspell
shopt -s autocd

export LD_PRELOAD=""
unset LD_PRELOAD


function exp-rel {
    cat ~/.local/state/caelestia/sequences.txt 2> /dev/null
}

function gitprompt {
    if [[ "$lgitpwd" != "$PWD" ]]; then
	gitpurl="$(git remote get-url origin 2>/dev/null)"
	gitpbranch="$(git branch --show-current 2>/dev/null)"
	if [[ -n "$gitpurl" ]]; then
	    gitpurl=${gitpurl#*.com/}
	    printf -v GIT_PROMPT "\n\e[34m│\e[92m in [$gitpurl:$gitpbranch]\e[0m"
	    gitpromptc=4
	else
	    GIT_PROMPT=""
	    gitpromptc=3
	fi
    else
	if [[ -z "$gitpurl" ]]; then
	    GIT_PROMPT=""
	    gitpromptc=3
	else
	    gitpromptc=4
	fi
    fi
    lgitpwd="$PWD"
}

exp-rel
source ~/.sh_aliases
source ~/.sh_funcs
if [[ $- != *i* ]]; then
    printf "Non-interactive shell"
    printpromptcfg=false
else
    if [[ $printpromptcfg != false ]]; then
	stty intr s
	trap 'printpromptcfg=false; trap - SIGINT; stty intr ^C; stty sane; kill -TERM $$' SIGINT
	( source ~/.sh_openanim )
	trap - SIGINT
    fi
fi

gitprompt

# Prompt Setting

