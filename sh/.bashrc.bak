prompt_update() {
    :
}

prompt_update

cmdprompt="Please wait"
cmdtm="0.1"

if [[ $cmdpromptenabled == true ]]; then
    cmd_update() {
	stty -echo
        for f in {1..1}; do
	    printf "$cmdprompt"
	    for f in {1..3}; do
		sleep $cmdtm
		printf "."
	   done
	   sleep $cmdtm
	   printf "\e[3D\e[1K"
        done
	printf "\e[999D\e[2K"
	stty echo
    }
else
    cmd_update() {
	:
    }
fi

openprompt() {
    stty -echo
    stty intr s

    printf "\e[0;0H\e[0m\e[31mHyptonics AE 2.4.1 // ZL_1601\e[999;0H\e[32mArch Linux\e[999;999H\e[16DRHEL to USA // TS\e[0;0H"
    printf "\e[$(($(tput lines) / 2 - 20))B"

    if [[ $printpromptcfg != false ]]; then
	local fifo
	fifo=$(mktemp -u)
	mkfifo "$fifo"

	{ echol < "$fifo" & } 2>/dev/null
	    echol_pid=$!

	    _openprompt_cancel() {
		exec {fd}>"$fifo"          # open + immediately close the write end
		exec {fd}>&-               # closes it, echol gets EOF, loop ends
		kill "$echol_pid" 2>/dev/null
		wait "$echol_pid" 2>/dev/null
		rm -f "$fifo"
		stty echo
		trap - SIGINT
		stty intr ^C
		printf "\e[3J\e[999A"
	    }
	trap '_openprompt_cancel; return' SIGINT

	fastfetch --pipe false > "$fifo"   # blocks until echol reads it all
	rm -f "$fifo"
	wait "$echol_pid" 2>/dev/null
    fi

    stty intr ^C

    # If we get here, animation finished normally
    [[ $printpromptcfg == false ]] || printf "${prompta}\n" | echos
    [[ $printpromptcfg == false ]] || printf "${promptb}\e[?25l\e[70D\e[${gitpromptc}A\e[0m" | echos

    stty echo
    trap - SIGINT
#    printf "%b" "\e[94m    _             _       _     _                  
#   / \   _ __ ___| |__   | |   (_)_ __  _   ___  __
#  / _ \ | '__/ __| '_ \  | |   | | '_ \| | | \ \/ /
# / ___ \| | | (__| | | | | |___| | | | | |_| |>  < 
#/_/   \_\_|  \___|_| |_| |_____|_|_| |_|\__,_/_/\_\\
#" | echol
}

trap "cmd_update" DEBUG

PROMPT_COMMAND="gitprompt; prompt_update"

if [[ $(id -u) == "0" ]]; then
    promptid="root#"
else
    promptid="$"
fi

SH_VER=$(printf "$BASH_VERSION" | cut -d'(' -f1)
MXCOLOR="\[\033[0m\]"

printf -v prompta '%b' "\e[s\n\e[34m╭────────────────────────"
printf -v promptb '%b' "│\e[31m $promptid \e[34m- \e[34m$(pwd)$GIT_PROMPT
\e[34m│ \e[35mbash $SH_VER \e[34m>_ "

PSG="\[\e[?25h\n\e[34m╭────────────────────────\]
\[│\e[31m $promptid \e[34m- \e[34m\$(pwd)\$GIT_PROMPT\]
\[\e[34m\]│ \[\e[35m\]bash $SH_VER \[\e[34m\]>_ "
PS1="${PSG}${MXCOLOR}"
PS2="\[\e[2K\]> "


